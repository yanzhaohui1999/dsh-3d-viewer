{
  "name": "dsh-3d-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "3D model viewer for DeepSeek Harness: STEP / STP / STL / GLB / GLTF in the better-sidebar file tree, with a native document-preview fallback.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify-step.mjs",
    "build:smoke": "npm_config_cache=/tmp/npm-cache npx --yes esbuild@0.25.0 scripts/smoke-entry.js --bundle --format=iife --platform=browser --minify --loader:.wasm=binary --external:fs --external:path --outfile=scripts/smoke.bundle.js"
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.19.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "three": "0.169.0",
    "occt-import-js": "0.0.23"
  }
}
