{
  "name": "dsh-3d-viewer",
  "version": "0.1.0",
  "type": "module",
  "description": "3D model viewer for DeepSeek Harness: STEP / STP / STL / GLB / GLTF in the better-sidebar file tree, with a native document-preview fallback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanzhaohui1999/dsh-3d-viewer.git"
  },
  "homepage": "https://github.com/yanzhaohui1999/dsh-3d-viewer#readme",
  "bugs": {
    "url": "https://github.com/yanzhaohui1999/dsh-3d-viewer/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "3d",
    "step",
    "stl",
    "gltf",
    "viewer"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "licenses/*.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify-step.mjs",
    "test": "node scripts/test-extof.mjs && node scripts/test-viewer.mjs && node scripts/test-fit.mjs && node scripts/test-limits.mjs",
    "build:smoke": "esbuild scripts/smoke-entry.js --bundle --format=iife --platform=browser --minify --loader:.wasm=binary --external:fs --external:path --outfile=scripts/smoke.bundle.js"
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.19.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "three": "0.169.0",
    "occt-import-js": "0.0.23"
  }
}
